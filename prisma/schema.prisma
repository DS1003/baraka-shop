generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  role      Role      @default(USER)
  image     String?
  address   String?
  phone     String?   @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  username  String?   @unique
  metadata  Json?     @default("{}")
  orders        Order[]
  reviews       Review[]
  reports       Report[]
  wishlist      Product[]      @relation("Wishlist")
  notifications Notification[]
  collaboratorProfile CollaboratorProfile?
}

model Product {
  id                   String                @id @default(uuid())
  name                 String
  slug                 String                @unique
  description          String?
  price                Float?                @default(0)
  oldPrice             Float?
  stock                Int                   @default(0)
  images               String[]
  videos               String[]
  categoryId           String
  subCategoryId        String?
  brandId              String?
  isFeatured           Boolean               @default(false)
  isNew                Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  metadata             Json?                 @default("{}")
  thirdLevelCategoryId String?
  promotionId          String?
  storeId              String?
  features             Json?                 @default("[]")
  packageContent       Json?                 @default("[]")
  shortDescription     String?
  reference            String?               @unique
  detailedDescription  Json?                 @default("[]")
  isPublished          Boolean               @default(true)
  deactivationReason   String?               // OUT_OF_STOCK | MANUAL | null
  deactivatedAt        DateTime?
  restockPendingReview Boolean               @default(false)
  restockedAt          DateTime?
  lastRestockedQty     Int?
  orderItems           OrderItem[]
  brand                Brand?                @relation(fields: [brandId], references: [id])
  category             Category              @relation(fields: [categoryId], references: [id])
  promotion            Promotion?            @relation(fields: [promotionId], references: [id])
  store                Store?                @relation(fields: [storeId], references: [id])
  subCategory          SubCategory?          @relation(fields: [subCategoryId], references: [id])
  thirdLevelCategory   ThirdLevelCategory?   @relation(fields: [thirdLevelCategoryId], references: [id])
  colorVariants        ProductColorVariant[]
  reviews              Review[]
  favoritedBy          User[]                @relation("Wishlist")
  aiProposal           ProductAiProposal?
  aiJobItems           AiEnrichmentJobItem[]

  @@index([name])
  @@index([slug])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([thirdLevelCategoryId])
  @@index([brandId])
  @@index([storeId])
  @@index([stock])
  @@index([deactivationReason])
  @@index([restockPendingReview])
}

model ProductColorVariant {
  id        String   @id @default(uuid())
  colorName String
  colorHex  String
  images    String[]
  productId String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Category {
  id            String        @id @default(uuid())
  name          String        @unique
  slug          String        @unique
  reference     String?       @unique
  image         String?
  isPublished   Boolean       @default(true)
  products      Product[]
  subCategories SubCategory[]
}

model SubCategory {
  id                   String               @id @default(uuid())
  name                 String
  slug                 String               @unique
  categoryId           String
  products             Product[]
  category             Category             @relation(fields: [categoryId], references: [id])
  thirdLevelCategories ThirdLevelCategory[]

  @@unique([name, categoryId])
}

model ThirdLevelCategory {
  id            String      @id @default(uuid())
  name          String
  slug          String      @unique
  subCategoryId String
  products      Product[]
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id])

  @@unique([name, subCategoryId])
}

model Brand {
  id       String    @id @default(uuid())
  name     String    @unique
  slug     String    @unique
  image    String?
  products Product[]
}

model Order {
  id             String      @id @default(uuid())
  userId         String
  status         OrderStatus @default(PENDING)
  paymentStatus  String      @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  total          Float
  subtotal       Float?
  couponCode     String?
  discountAmount Float?      @default(0)
  paymentMethod  String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deliveryMethod  String?
  deliveryZone    String?
  shippingAddress String?
  shippingPhone   String?
  customerName    String?
  shippingCity    String?
  shippingCost    Float?      @default(0)
  user            User        @relation(fields: [userId], references: [id])
  items           OrderItem[]
  CommissionOrderEntry CommissionOrderEntry[]

  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id            String  @id @default(uuid())
  orderId       String
  productId     String
  quantity      Int
  price         Float
  selectedColor String?
  order         Order   @relation(fields: [orderId], references: [id])
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String?
  userId         String
  productId      String
  helpfulCount   Int       @default(0)
  unhelpfulCount Int       @default(0)
  adminReply     String?
  adminReplyAt   DateTime?
  createdAt      DateTime  @default(now())
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id])
  reports        Report[]
}

model Report {
  id        String   @id @default(uuid())
  reason    String
  comment   String?
  status    String   @default("PENDING") // PENDING, RESOLVED, IGNORED
  userId    String
  reviewId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model ImportJob {
  id             String   @id @default(uuid())
  status         String   @default("PENDING")
  progress       Int      @default(0)
  totalItems     Int      @default(0)
  processedItems Int      @default(0)
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Media {
  id        String   @id @default(uuid())
  name      String
  url       String
  publicId  String   @unique
  format    String?
  size      Int?
  type      String   @default("image")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model MediaJob {
  id             String   @id @default(uuid())
  status         String   @default("PENDING")
  progress       Int      @default(0)
  totalItems     Int      @default(0)
  processedItems Int      @default(0)
  matchedCount   Int      @default(0)
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Promotion {
  id                 String    @id @default(uuid())
  name               String
  description        String?
  startDate          DateTime
  endDate            DateTime
  discountPercentage Float
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  products           Product[]
}

model Store {
  id             String    @id @default(uuid())
  name           String    @unique
  slug           String    @unique
  logo           String?
  description    String?
  address        String?
  phone          String?
  hours          String?
  type           String?
  city           String?
  mapUrl         String?
  isClickCollect Boolean   @default(false)
  isSav          Boolean   @default(false)
  isBarakaShop   Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  banner         String?
  logo_detail    String?
  products       Product[]
}

model PopularUniverse {
  id        String   @id @default(uuid())
  name      String
  subtitle  String?
  image     String?
  href      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HomePromo {
  id        String   @id @default(uuid())
  badge     String?
  title     String
  subtitle  String?
  price     String?
  image     String
  bg        String   @default("bg-slate-50")
  border    String   @default("border-slate-100")
  size      String   @default("md:col-span-1")
  href      String   @default("/boutique")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BigBanner {
  id          String   @id @default(uuid())
  title       String
  subtitle    String?
  description String?
  badge       String?
  image       String
  href        String   @default("/boutique")
  buttonText  String   @default("Commander")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteConfig {
  id                 String   @id @default("singleton")
  maintenanceMode    Boolean  @default(false)
  maintenanceTitle   String   @default("Site en maintenance")
  maintenanceMessage String   @default("Nous effectuons des améliorations. Le site sera de retour très bientôt.")
  headerLogo                  String?
  footerLogo                  String?
  loaderLogo                  String?
  restockNotificationEmails    String[] @default([])
  restockNotificationsEnabled Boolean  @default(true)
  updatedAt                   DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
  COLLABORATOR
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model PhysicalStore {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  image          String?
  description    String?
  address        String?
  phone          String?
  hours          String?
  type           String?
  city           String?
  mapUrl         String?
  isClickCollect Boolean  @default(false)
  isSav          Boolean  @default(false)
  isPublished    Boolean  @default(true)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SyncConfig {
  id              String   @id @default("singleton")
  ftpServer       String   @default("rs5.cloudlws.com")
  ftpUser         String?
  ftpPassword     String?
  ftpPath         String   @default("/files/BARAKA/")
  scheduleTimes   String[] @default(["00:00", "12:00"])
  isActive        Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

model SyncHistory {
  id                String    @id @default(uuid())
  status            String    @default("PENDING") // PENDING, SUCCESS, ERROR
  type              String    @default("MANUAL") // MANUAL, SCHEDULED
  productsUpdated   Int       @default(0)
  categoriesUpdated Int       @default(0)
  errorDetails      String?
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // ORDER_CREATED, ORDER_PROCESSING, ORDER_SHIPPED, ORDER_DELIVERED, ORDER_CANCELLED, ORDER_READY_PICKUP, NEW_ORDER_ADMIN
  title     String
  message   String
  orderId   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model PromotionCampaign {
  id                 String    @id @default(uuid())
  name               String
  title              String?
  description        String?
  discountType       String    @default("PERCENTAGE") // PERCENTAGE | FIXED_AMOUNT
  discountValue      Float
  couponCode         String    @unique
  startDate          DateTime
  endDate            DateTime
  isActive           Boolean   @default(true)
  showPopup          Boolean   @default(true)
  popupTitle         String?
  popupDescription   String?
  popupImage         String?
  ctaText            String?   @default("Profiter de l'offre")
  ctaLink            String?   @default("/boutique")
  maxUses            Int?
  maxUsesPerUser     Int       @default(1)
  minimumOrderAmount Float     @default(0)
  firstPurchaseOnly  Boolean   @default(false)
  displayFrequency   String    @default("ONCE_PER_CAMPAIGN") // ONCE_PER_SESSION | ONCE_PER_DAY | ONCE_PER_CAMPAIGN | ALWAYS
  popupViews         Int       @default(0)
  popupClicks        Int       @default(0)
  codeCopies         Int       @default(0)
  codeUses           Int       @default(0)
  totalRevenue       Float     @default(0)
  totalDiscount      Float     @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  usages             CouponUsage[]

  @@index([couponCode])
  @@index([isActive])
}

model CouponUsage {
  id         String            @id @default(uuid())
  campaignId String
  userId     String
  orderId    String?
  usedAt     DateTime          @default(now())
  campaign   PromotionCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([userId])
  @@unique([campaignId, orderId])
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("UNREAD") // UNREAD, READ, REPLIED, ARCHIVED
  replyNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
}

// ─── Newsletter ──────────────────────────────────────────────────────────────
// Double opt-in : PENDING → (lien de confirmation) → ACTIVE → UNSUBSCRIBED
model NewsletterSubscriber {
  id             String    @id @default(uuid())
  email          String    @unique
  status         String    @default("PENDING") // PENDING, ACTIVE, UNSUBSCRIBED
  token          String    @unique             // jeton aléatoire 256 bits (confirmation + désinscription)
  source         String?   @default("HOME")
  userId         String?
  ipHash         String?                       // SHA-256 salé, jamais l'IP en clair
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  lastSentAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

model NewsletterCampaign {
  id             String    @id @default(uuid())
  subject        String
  previewText    String?
  heading        String
  content        String                        // texte brut, échappé au rendu (pas de HTML)
  imageUrl       String?
  ctaText        String?
  ctaUrl         String?
  status         String    @default("DRAFT")   // DRAFT, SENDING, SENT, FAILED
  recipientCount Int       @default(0)
  sentCount      Int       @default(0)
  failedCount    Int       @default(0)
  createdById    String?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ─── Espace Collaborateur ───────────────────────────────────────────────────

model CollaboratorProfile {
  id                        String                      @id @default(uuid())
  userId                    String                      @unique
  title                     String                      @default("Collaborateur Commercial")
  collaborationType         String                      @default("PARTENAIRE")
  startDate                 DateTime                    @default(now())
  endDate                   DateTime?
  status                    String                      @default("ACTIVE") // ACTIVE, SUSPENDED, TERMINATED
  bankDetails               String?
  notes                     String?
  permissions               String[]                    @default([]) // Permissions opérationnelles ex: ["MANAGE_ORDERS", "VIEW_STOCK"]
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  activities                CollaboratorActivity[]
  payments                  CollaboratorPayment[]
  user                      User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  CommissionPeriod          CommissionPeriod[]
  CompensationAgreement     CompensationAgreement[]
  CompensationChangeRequest CompensationChangeRequest[]
  notificationHistory       CollaboratorNotificationHistory[]

  @@index([status])
  @@index([userId])
}

model CollaboratorPayment {
  id               String              @id @default(uuid())
  collaboratorId   String
  periodId         String?
  type             String              @default("SALARY_AND_COMMISSION") // SALARY, COMMISSION, SALARY_AND_COMMISSION, ADVANCE, BONUS
  amount           Float
  paymentDate      DateTime            @default(now())
  paymentMethod    String              @default("BANK_TRANSFER") // BANK_TRANSFER, ORANGE_MONEY, WAVE, CASH
  reference        String?
  receiptUrl       String?
  recordedById     String?
  recordedByName   String?
  notes            String?
  createdAt        DateTime            @default(now())
  collaborator     CollaboratorProfile @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  CommissionPeriod CommissionPeriod?   @relation(fields: [periodId], references: [id])

  @@index([collaboratorId])
  @@index([paymentDate])
  @@index([periodId])
}

model CollaboratorActivity {
  id             String              @id @default(uuid())
  collaboratorId String
  actionType     String
  entityType     String              @default("COLLABORATOR")
  entityId       String?
  description    String
  metadata       Json?               @default("{}")
  ipAddress      String?
  createdAt      DateTime            @default(now())
  collaborator   CollaboratorProfile @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)

  @@index([collaboratorId])
  @@index([createdAt])
  @@index([actionType])
}

model CommissionOrderEntry {
  id               String           @id @default(uuid())
  periodId         String
  orderId          String
  orderReference   String
  orderDate        DateTime
  orderTotal       Float
  eligibleAmount   Float
  commissionRate   Float
  commissionAmount Float
  orderStatus      String
  paymentStatus    String
  createdAt        DateTime         @default(now())
  Order            Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  CommissionPeriod CommissionPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, orderId])
  @@index([orderId])
  @@index([periodId])
}

model CommissionPeriod {
  id                   String                 @id @default(uuid())
  collaboratorId       String
  periodCode           String                 // Format YYYY-MM (ex: 2026-11)
  startDate            DateTime
  endDate              DateTime
  eligibleRevenue      Float                  @default(0)
  totalOrdersCount     Int                    @default(0)
  eligibleOrdersCount  Int                    @default(0)
  commissionRate       Float                  @default(0)
  commissionAmount     Float                  @default(0)
  salaryAmount         Float                  @default(0)
  totalDue             Float                  @default(0)
  commissionPaid       Float                  @default(0)
  salaryPaid           Float                  @default(0)
  totalPaid            Float                  @default(0)
  remainingBalance     Float                  @default(0)
  status               String                 @default("CALCULATING") // CALCULATING, VALIDATED, PAID, ARCHIVED
  isFrozen             Boolean                @default(false)
  validatedAt          DateTime?
  validatedById        String?
  adjustmentAmount     Float                  @default(0)
  adjustmentReason     String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  CollaboratorPayment  CollaboratorPayment[]
  CommissionOrderEntry CommissionOrderEntry[]
  CollaboratorProfile  CollaboratorProfile    @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)

  @@unique([collaboratorId, periodCode])
  @@index([collaboratorId])
  @@index([periodCode])
  @@index([status])
}

model CompensationAgreement {
  id                 String              @id @default(uuid())
  collaboratorId     String
  monthlySalary      Float               @default(0)
  commissionRate     Float               @default(0)
  calculationBase    String              @default("DELIVERED_SALES") // DELIVERED_SALES, ALL_SALES, NET_MARGIN
  eligibleStatuses   String[]            @default(["DELIVERED"])
  includeDeliveryFee Boolean             @default(false)
  paymentFrequency   String              @default("MONTHLY")
  paymentDueDay      Int                 @default(5)
  effectiveFrom      DateTime            @default(now())
  effectiveTo        DateTime?
  status             String              @default("ACTIVE") // ACTIVE, SUPERSEDED, CANCELLED
  changeReason       String?
  createdById        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  CollaboratorProfile CollaboratorProfile @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)

  @@index([collaboratorId])
  @@index([effectiveFrom])
  @@index([status])
}

model CompensationChangeRequest {
  id                  String              @id @default(uuid())
  collaboratorId      String
  requestedSalary     Float?
  requestedRate       Float?
  requestedBase       String?
  reason              String?
  status              String              @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedById        String?
  reviewNote          String?
  reviewedAt          DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  CollaboratorProfile CollaboratorProfile @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)

  @@index([collaboratorId])
  @@index([status])
}

model FinancialAuditLog {
  id              String    @id @default(uuid())
  collaboratorId  String
  action          String
  performedById   String
  performedByName String?
  oldValue        Json?
  newValue        Json?
  reason          String?
  effectiveDate   DateTime?
  createdAt       DateTime  @default(now())

  @@index([action])
  @@index([collaboratorId])
  @@index([createdAt])
}

model CollaboratorNotificationHistory {
  id             String              @id @default(uuid())
  collaboratorId String
  collaborator   CollaboratorProfile @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  email          String
  type           String              @default("WELCOME_NOMINATION")
  status         String              @default("SENT") // SENT, FAILED, SIMULATED
  errorMessage   String?
  sentAt         DateTime            @default(now())
  retries        Int                 @default(0)

  @@index([collaboratorId])
  @@index([status])
  @@index([sentAt])
}

model ProductAiProposal {
  id                 String    @id @default(uuid())
  productId          String    @unique
  status             String    @default("TO_REVIEW") // PENDING, GENERATING, GENERATED, TO_REVIEW, VALIDATED, SAVED, PUBLISHED, FAILED
  shortDescription   String?
  generalDescription String?
  classicDescription String?
  features           Json?     @default("[]")
  specifications     Json?     @default("{}")
  rawSpecsText       String?
  appliedFields      String[]  @default([])
  modelUsed          String?
  promptTokens       Int?
  completionTokens   Int?
  errorMessage       String?
  generatedAt        DateTime?
  reviewedAt         DateTime?
  reviewedBy         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  product            Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([productId])
  @@index([createdAt])
}

model AiEnrichmentJob {
  id             String               @id @default(uuid())
  name           String
  status         String               @default("PENDING") // PENDING, RUNNING, COMPLETED, PAUSED, CANCELLED, FAILED
  filterType     String?              // INCOMPLETE, CATEGORY, BRAND, MANUAL
  filterValue    String?
  totalProducts  Int                  @default(0)
  processedCount Int                  @default(0)
  successCount   Int                  @default(0)
  errorCount     Int                  @default(0)
  costEstimate   Float                @default(0)
  createdById    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  items          AiEnrichmentJobItem[]

  @@index([status])
  @@index([createdAt])
}

model AiEnrichmentJobItem {
  id           String          @id @default(uuid())
  jobId        String
  productId    String
  status       String          @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, SKIPPED
  errorMessage String?
  proposalId   String?
  startedAt    DateTime?
  completedAt  DateTime?
  job          AiEnrichmentJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([productId])
  @@index([status])
}
